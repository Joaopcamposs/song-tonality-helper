# Token do Cloudflare Tunnel (painel Zero Trust > Networks > Tunnels). Copie para .env e preencha.
TUNNEL_TOKEN=

# Banco (opcional no compose, que usa o serviço db). Para outro Postgres, como o Neon, use
# postgresql+asyncpg://usuario:senha@host:5432/banco (com asyncpg, `ssl=require` em vez de `sslmode=require`).
# DATABASE_URL=
# Senha do Postgres do compose (padrão dev, só para desenvolvimento).
# POSTGRES_PASSWORD=dev

# Palavra secreta (opcional). Se definida, toda rota /api (menos /api/health) exige o cabeçalho
# X-App-Passphrase com ela, e a tela pede a palavra. Vazia ou ausente: sem proteção.
# Use só caracteres ASCII (sem acentos): o cabeçalho HTTP é latin-1.
# APP_PASSPHRASE=

# Worker: segundos entre consultas à fila (padrão 5).
# WORKER_POLL_SECONDS=5
# API: máximo de novos pedidos de análise por IP por hora (padrão 20).
# MAX_REQUESTS_PER_HOUR=20

# Experimento (API): proxy residencial rotativo para a própria API baixar o áudio, com fallback
# para o worker. Sem usuário e senha: desligado. São segredos. Mesmas variáveis do job_scrapper.
# PROXY_USERNAME=
# PROXY_PASSWORD=
# Padrão pr.oxylabs.io:7777.
# PROXY_HOST=
# País de saída (ex.: br).
# PROXY_COUNTRY=
# Vazio: IP novo a cada request; número: IP fixo por esse tempo (sticky).
# PROXY_SESSION_MINUTES=
